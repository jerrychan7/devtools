{
  "name": "devtools-anywhere-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm run build && pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.scripts.json",
    "test": "pnpm run build && node --test \"tests/**/*.test.mjs\"",
    "playground": "node playground/server.mjs",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.11.2"
}
