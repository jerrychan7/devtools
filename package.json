{
  "name": "devtools-anywhere-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm run build && pnpm -r --parallel run dev",
    "typecheck": "pnpm run build && pnpm -r run typecheck && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "test": "pnpm run build && node --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "playground": "node playground/server.ts",
    "licenses:update": "node scripts/third-party-licenses.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@devtools-anywhere/cdp-server": "workspace:*",
    "@devtools-anywhere/remote-server": "workspace:*",
    "@devtools-anywhere/vite-plugin": "workspace:*",
    "@types/node": "^22.18.0",
    "acorn": "^8.19.0",
    "devtools-protocol": "^0.0.1721318",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ],
    "*.{json,html,css,yaml,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.11.2"
}
