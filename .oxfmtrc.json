{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "ignorePatterns": [
    "**/*.md",
    "pnpm-lock.yaml",
    "packages/devtools-frontend/src/**",
    "packages/devtools-frontend/patches/**",
    "experiments/**"
  ]
}
