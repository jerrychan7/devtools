import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../visibility.gni")

# embedder.ts is copied in from packages/devtools-anywhere at build time (scripts/build.ts).
devtools_module("embedder") {
  sources = [ "embedder.ts" ]
}

devtools_entrypoint("entrypoint") {
  entrypoint = "anywhere_app.ts"

  deps = [ "../../Images:optimize_images" ]

  ts_deps = [
    ":embedder",
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/root:bundle",
    "../../entrypoints/inspector_main:meta",
    "../../panels/application:meta",
    "../../panels/common:meta",
    "../../panels/console:meta",
    "../../panels/console_counters:meta",
    "../../panels/elements:meta",
    "../../panels/mobile_throttling:meta",
    "../../panels/network:meta",
    "../../panels/screencast:meta",
    "../../panels/settings:meta",
    "../../panels/sources:bundle",
    "../../panels/sources:meta",
    "../../ui/dom_extension:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/perf_ui:meta",
    "../../ui/legacy/components/quick_open:meta",
    "../../ui/legacy/components/source_frame:meta",
    "../main:bundle",
    "../main:meta",
  ]

  visibility = [ "../../:*" ]
  visibility += devtools_entrypoints_visibility
}
