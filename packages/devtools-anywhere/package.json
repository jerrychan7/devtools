{
  "name": "devtools-anywhere",
  "version": "0.0.0",
  "description": "Real Chrome DevTools inside any web page, with early capture",
  "license": "MIT",
  "files": [
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*.iife.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./devtools-anywhere.iife.js": "./dist/devtools-anywhere.iife.js",
    "./probe.iife.js": "./dist/probe.iife.js",
    "./devtools-anywhere-sw.js": "./dist/devtools-anywhere-sw.js",
    "./snapdom.js": "./dist/snapdom.js"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json",
    "dev": "node build.ts --watch"
  },
  "dependencies": {
    "@devtools-anywhere/cdp-server": "workspace:*",
    "@zumer/snapdom": "^3.3.5"
  },
  "devDependencies": {
    "@devtools-anywhere/relay-core": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
