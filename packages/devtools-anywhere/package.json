{
  "name": "devtools-anywhere",
  "version": "0.0.0",
  "description": "Real Chrome DevTools inside any web page, with early capture",
  "keywords": [
    "cdp",
    "chrome-devtools",
    "debugging",
    "devtools",
    "inspector",
    "mobile"
  ],
  "homepage": "https://github.com/jerrychan7/devtools#readme",
  "bugs": {
    "url": "https://github.com/jerrychan7/devtools/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerrychan7/devtools.git",
    "directory": "packages/devtools-anywhere"
  },
  "files": [
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*.iife.js"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./devtools-anywhere.iife.js": "./dist/devtools-anywhere.iife.js",
    "./probe.iife.js": "./dist/probe.iife.js",
    "./devtools-anywhere-service-worker.js": "./dist/devtools-anywhere-service-worker.js",
    "./snapdom.js": "./dist/snapdom.js"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/api-extract.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.service-worker.json && tsc -p tsconfig.cdp-agent.json",
    "dev": "node build.ts --watch"
  },
  "dependencies": {
    "@zumer/snapdom": "^3.3.5"
  },
  "devDependencies": {
    "@devtools-anywhere/relay-core": "workspace:*",
    "devtools-protocol": "^0.0.1721318",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "chrome": "156.0.8078.80"
}
