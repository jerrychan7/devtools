{
  "name": "@devtools-anywhere/vite-plugin",
  "version": "0.0.0",
  "description": "Vite plugin that injects devtools-anywhere in development",
  "keywords": [
    "chrome-devtools",
    "debugging",
    "devtools",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/jerrychan7/devtools#readme",
  "bugs": {
    "url": "https://github.com/jerrychan7/devtools/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerrychan7/devtools.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/api-extract.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node build.ts --watch"
  },
  "dependencies": {
    "@devtools-anywhere/devtools-frontend": "workspace:*",
    "devtools-anywhere": "workspace:*"
  },
  "devDependencies": {
    "@devtools-anywhere/devtools-frontend-locales": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "peerDependencies": {
    "@devtools-anywhere/devtools-frontend-locales": "workspace:*",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@devtools-anywhere/devtools-frontend-locales": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "chrome": "156.0.8078.80"
}
