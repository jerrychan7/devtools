{
  "name": "@devtools-anywhere/remote-server",
  "version": "0.1.0",
  "description": "Relay that lets Chrome DevTools on one machine inspect a page running on another device",
  "keywords": [
    "cdp",
    "chrome-devtools",
    "devtools",
    "remote-debugging",
    "websocket"
  ],
  "homepage": "https://github.com/jerrychan7/devtools#readme",
  "bugs": {
    "url": "https://github.com/jerrychan7/devtools/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerrychan7/devtools.git",
    "directory": "packages/remote-server"
  },
  "bin": {
    "devtools-anywhere-remote": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/api-extract.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node build.ts --watch"
  },
  "dependencies": {
    "@devtools-anywhere/devtools-frontend": "workspace:*",
    "devtools-anywhere": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@devtools-anywhere/devtools-frontend-locales": "workspace:*",
    "@devtools-anywhere/relay-core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@devtools-anywhere/devtools-frontend-locales": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@devtools-anywhere/devtools-frontend-locales": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "chrome": "156.0.8078.80"
}
