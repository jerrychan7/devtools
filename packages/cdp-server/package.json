{
  "name": "@devtools-anywhere/cdp-server",
  "version": "0.0.0",
  "description": "In-page Chrome DevTools Protocol server with an early-capture probe",
  "license": "MIT",
  "files": [
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*.iife.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "import": "./dist/probe.js"
    },
    "./probe.iife.js": "./dist/probe.iife.js",
    "./cdp-server.iife.js": "./dist/cdp-server.iife.js"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/api-extract.ts api-extractor.json api-extractor.probe.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node build.ts --watch"
  },
  "devDependencies": {
    "devtools-protocol": "^0.0.1721318",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
