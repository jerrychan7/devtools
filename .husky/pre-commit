pnpm exec lint-staged
# Each contract literal is written in one file only (scripts/check-contracts.ts); under a second.
node scripts/check-contracts.ts
# Source files past 1100 lines get a warning, past 1500 the commit is rejected (scripts/check-file-size.ts).
node scripts/check-file-size.ts
# Directories past 20 files get a warning, past 30 the commit is rejected (scripts/check-dir-size.ts).
node scripts/check-dir-size.ts
# The devtools-frontend checkout must hold no edit to upstream files outside the patches, or a
# build from a fresh checkout would lack it. The check takes seconds: only for commits that
# touch the frontend package.
if git diff --cached --name-only | grep -q '^packages/devtools-frontend/'; then
  node packages/devtools-frontend/scripts/check-checkout.ts
fi
